# Server
HTTP_ADDR=:8080

# Neon Postgres — leave empty for in-memory (resets on restart).
# Easiest: claimable DB (no Neon account, expires in 72h unless claimed):
#   make neon
# That writes DATABASE_URL + PUBLIC_POSTGRES_CLAIM_URL into .env
DATABASE_URL=

# Comma-separated admin tokens for scripts / curl (Bearer). The admin UI uses Google sign-in when configured.
ADMIN_TOKENS=dev-admin-token

# Google sign-in for /admin (recommended in production).
# Create an OAuth 2.0 Web client in Google Cloud Console:
#   Authorized JavaScript origins: https://YOUR_HOST  and  http://127.0.0.1:5173
#   Redirect URIs: https://YOUR_HOST/api/auth/google/callback
#                  http://127.0.0.1:5173/api/auth/google/callback
#                  http://127.0.0.1:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in: emails and/or a Google Workspace domain. At least one is required when Google is enabled.
ADMIN_EMAILS=
# ADMIN_GOOGLE_HOSTED_DOMAIN=yourschool.com
# SESSION_SECRET=

# Public portal base URL for the student request page + Web Clip.
# For live MDM, prefer the same host as MDM_PUBLIC_URL (devices cannot open localhost).
# If this is still localhost while MDM_PUBLIC_URL is set, the server uses MDM_PUBLIC_URL for device profiles.
PORTAL_BASE_URL=http://localhost:8080

# Credits + Nedarim Plus payments
# NEDARIM_MODE=fake (default) simulates DebitIframe locally for full webhook/ledger flow.
# NEDARIM_MODE=live requires Mosad + ApiValid (and optionally ApiPassword).
NEDARIM_MODE=fake
NEDARIM_MOSAD_ID=
NEDARIM_API_PASSWORD=
NEDARIM_API_VALID=
# Cost in credits for each access (app/URL) request. General/bug requests are free.
CREDITS_ACCESS_COST=1

# Apple MDM protocol (additive). stub = school features only; live = /mdm /scep /enroll + APNs.
# See docs/mdm-continuity.md and docs/mdm-identity.md
MDM_ENQUEUE=stub
MDM_PUBLIC_URL=https://nanok.kfilter.net
MDM_TOPIC=
MDM_CHECKIN=false
# MDM_CERT_HEADER=
MDM_SCEP_CAPASS=
# MDM_SCEP_CHALLENGE=
MDM_DEBUG=false
# Optional one-time seed for mdm_settings.dep_name when the DB row is empty.
# After first boot, edit the DEP name in Admin → Settings (not via env).
# MDM_DEP_NAME=nanok
