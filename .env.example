# Server
HTTP_ADDR=:8080

# Neon Postgres — leave empty for in-memory (resets on restart).
# Easiest: claimable DB (no Neon account, expires in 72h unless claimed):
#   make neon
# That writes DATABASE_URL + PUBLIC_POSTGRES_CLAIM_URL into .env
DATABASE_URL=

# Comma-separated admin tokens for Approve/Deny (Bearer token).
ADMIN_TOKENS=dev-admin-token

# Public portal base URL used when building the Request Access Web Clip.
PORTAL_BASE_URL=http://localhost:8080
