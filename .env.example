# Server
HTTP_ADDR=:8080

# Neon Postgres connection string.
# Create a reclaimable/ephemeral branch or DB with neonctl, then paste the URL:
#   neonctl branches create --name school-mdm-dev
#   neonctl connection-string school-mdm-dev
#
# Leave empty to use the in-memory store (fine for local API/policy work).
DATABASE_URL=

# Comma-separated admin tokens for Approve/Deny (Bearer token).
ADMIN_TOKENS=dev-admin-token

# Public portal base URL used when building the Request Access Web Clip.
PORTAL_BASE_URL=http://localhost:8080
