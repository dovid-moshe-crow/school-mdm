# Server
HTTP_ADDR=:8080

# Neon Postgres — leave empty for in-memory (resets on restart).
# Easiest: claimable DB (no Neon account, expires in 72h unless claimed):
#   make neon
# That writes DATABASE_URL + PUBLIC_POSTGRES_CLAIM_URL into .env
DATABASE_URL=

# Comma-separated admin tokens for Approve/Deny (Bearer token).
ADMIN_TOKENS=dev-admin-token

# Public portal base URL used when building the Request Access Web Clip.
PORTAL_BASE_URL=http://localhost:8080

# Credits + Nedarim Plus payments
# NEDARIM_MODE=fake (default) simulates DebitIframe locally for full webhook/ledger flow.
# NEDARIM_MODE=live requires Mosad + ApiValid (and optionally ApiPassword).
NEDARIM_MODE=fake
NEDARIM_MOSAD_ID=
NEDARIM_API_PASSWORD=
NEDARIM_API_VALID=
# Cost in credits for each access (app/URL) request. General/bug requests are free.
CREDITS_ACCESS_COST=1
