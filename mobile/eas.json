{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_PORTAL_BASE_URL": "https://nanok.kfilter.net"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_PORTAL_BASE_URL": "https://nanok.kfilter.net"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6800684446",
        "appleId": "eliyahu@yeshivatcy.co.il",
        "appleTeamId": "4J82HMXY47"
      }
    }
  }
}
